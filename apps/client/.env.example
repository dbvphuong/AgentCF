# Apply these environment variables in the shell; the CLI does not auto-load .env files.
AGENT_CF_CLIENT_SERVER_URL=http://127.0.0.1:8000
AGENT_CF_CLIENT_TIMEOUT_SECONDS=5
# Desktop profile override for development/tests only; default is %LOCALAPPDATA%\AgentCF.
# AGENT_CF_CLIENT_HOME=E:\AgentCF\client-profile
