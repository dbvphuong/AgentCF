# Set these environment variables in the shell; no implicit .env loader.
# Relative paths resolve from the working directory. Launch from repository root.
AGENT_CF_SERVER_HOST=127.0.0.1
AGENT_CF_SERVER_PORT=8000
AGENT_CF_SERVER_DATABASE_PATH=runtime/server/agent_cf.sqlite3
AGENT_CF_SERVER_DATABASE_BUSY_TIMEOUT_MS=5000
AGENT_CF_SERVER_TEMPORAL_ENABLED=true
AGENT_CF_SERVER_TEMPORAL_ADDRESS=127.0.0.1:7233
AGENT_CF_SERVER_TEMPORAL_NAMESPACE=default
AGENT_CF_SERVER_TEMPORAL_TASK_QUEUE=agent-cf-process-v1
AGENT_CF_SERVER_REQUEST_TIMEOUT_SECONDS=5
AGENT_CF_SERVER_CLIENT_INSTALLER_PATH="runtime/client-build/CF Client Setup.exe"
